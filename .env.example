# Claude Telegram Bot
# Environment Configuration

# ==============================================================================
# REQUIRED
# ==============================================================================

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=1234567890:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Comma-separated Telegram user IDs allowed to use the bot
# Find your ID: message @userinfobot on Telegram
TELEGRAM_ALLOWED_USERS=123456789

# ==============================================================================
# RECOMMENDED
# ==============================================================================

# Working directory where Claude runs (loads CLAUDE.md, skills, MCP config)
CLAUDE_WORKING_DIR=/path/to/your/projects

# ==============================================================================
# OPTIONAL - Instance Identity
# ==============================================================================

# Instance name. Every per-instance path derives from it:
#   ~/.<BOT_ID>/          sessions, audit log, alert database
#   /tmp/<BOT_ID>/        downloaded media
#   /run/<BOT_ID>/        alert socket
# Set a distinct value per bot when running several instances of this code on
# one machine - otherwise they share sessions.json and overwrite each other.
# Allowed characters: letters, digits, dot, underscore, hyphen.
# Default: cc-telegram-bot
# BOT_ID=my-bot

# One-line role description, placed at the top of the system prompt.
# The detailed personality belongs in CLAUDE.md inside CLAUDE_WORKING_DIR;
# this is the sentence that has to outrank it. Override when building a bot
# that is not an admin assistant.
# Default: "You are a Claude-powered Telegram admin bot. ..."
# BOT_PERSONA=You are a Claude-powered research assistant. You communicate via Telegram.

# ==============================================================================
# OPTIONAL - Group Chat Support
# ==============================================================================

# Comma-separated Telegram group IDs allowed to interact with the bot
# The bot responds only to @mentions or replies in whitelisted groups
# Find your group ID: add @getmyid_bot to the group
# TELEGRAM_ALLOWED_GROUPS=-1001234567890

# ==============================================================================
# OPTIONAL - Alert Socket (requires group support)
# ==============================================================================

# Unix socket path for local alert ingestion
# Local scripts can send JSON alerts via socat to trigger Claude autonomously
# Requires TELEGRAM_ALLOWED_GROUPS to be set (alerts are posted to the first group)
# ALERT_SOCKET_PATH=/run/cc-telegram-bot/alerts.sock

# Shared secret for socket authentication (optional)
# ALERT_SOCKET_SECRET=

# ==============================================================================
# OPTIONAL - Daily Report (EOD Logbook)
# ==============================================================================

# Directory where daily bot activity logs are written
# Claude generates a Markdown report at the configured timer time (default: 23:55)
# Default: ~/Documents/bot-logs
# DAILY_LOG_DIR=/path/to/bot-logs

# ==============================================================================
# OPTIONAL - Security
# ==============================================================================

# Comma-separated paths Claude can access
# Default: working dir, ~/Documents, ~/Downloads, ~/Desktop, ~/.claude
# Note: Setting this OVERRIDES defaults. Include ~/.claude for plan mode to work.
# ALLOWED_PATHS=/path/to/projects,/path/to/documents,~/.claude

# Rate limiting (token bucket)
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_REQUESTS=20
# RATE_LIMIT_WINDOW=60

# ==============================================================================
# OPTIONAL - Tool Control
# ==============================================================================

# Both lists are empty by default. That is the behaviour every installation has
# today: the bot runs with bypassPermissions and passes no tool restriction at
# all, so Claude has Write/Edit/Bash everywhere inside ALLOWED_PATHS. Setting
# either list is opt-in and changes nothing until you do.

# Comma-separated allowlist of tools Claude may use (SDK option: `tools`).
# Deny-by-default: when set, ONLY these tools exist. Leave unset for the SDK's
# default tool set.
#
# IMPORTANT - this list governs BUILT-IN tools only. MCP tools are not filtered
# by it and stay available in full. Measured against SDK 0.3.233: with
# ALLOWED_TOOLS=Read,Grep,Glob the built-ins reduce to those three, while every
# tool of every configured MCP server remains. An allowlist alone therefore
# does NOT produce a read-only bot as soon as any MCP server is configured -
# use DISALLOWED_TOOLS below to reach those.
#
# Every tool the bot needs must be listed. Two that are easy to forget:
#   mcp__ask-user__*  omit it and the inline-keyboard flow stops working
#   Task              sub-agents inherit bypassPermissions. Their tool calls are
#                     detected by the bot (the SDK emits sub-agent tool blocks
#                     by default) but, like every call, only after dispatch.
#                     Denying Task removes that layer instead of watching it.
# Read-only documentation bot: Read,Grep,Glob,TodoWrite
# ALLOWED_TOOLS=Read,Grep,Glob,TodoWrite

# Comma-separated denylist, applied on top of the allowlist (SDK option:
# `disallowedTools`). Deny wins over allow. Leave unset to block nothing.
# Unlike the allowlist, this one does reach MCP tools.
#
# Accepted forms: exact name, prefix wildcard (mcp__server__*), or an MCP
# server name (mcp__server) to cover all of its tools. All three are honoured
# by the SDK option itself - verified against 0.3.233, where both the
# server-level and the wildcard form removed the server's entire tool set from
# the session, not merely from the bot's own runtime check.
# DISALLOWED_TOOLS=Write,Edit,NotebookEdit,Bash,Task

# ==============================================================================
# OPTIONAL - Cost Limit
# ==============================================================================

# Cumulative USD ceiling per Telegram user, per calendar month.
# Unset or 0 means unlimited, which is the current behaviour. Costs are
# recorded either way and shown in /status - you need the number before you can
# pick a sensible ceiling.
# Resets implicitly at the start of each calendar month (local time); the period
# is part of the database key, so there is no reset job that can fail to run.
# Stored in the SQLite database at ALERT_DB_PATH, table user_costs.
#
# The figure comes from the Agent SDK, which documents it as an estimate rather
# than a billing statement. Treat it as a guard rail, not as accounting.
#
# Two things it does not cover, both deliberate:
#   - the alert session is exempt, so a budget cannot silence system monitoring
#   - turns ended by an inline-keyboard hand-off or /stop never emit a cost
#     figure at all, so they are not billed
# COST_LIMIT_USD=25

# ==============================================================================
# OPTIONAL - Output Verbosity
# ==============================================================================

# How much of Claude's work is streamed to Telegram:
#   0  final answer only
#   1  thinking previews and tool status (default, the previous behaviour)
#   2  additionally tool results and a closing stats line
# Per-user override at runtime: /verbose 0|1|2 - held in memory like the /model
# override, so it survives /new and resets to this value when the bot restarts.
# Blocked commands, denied paths and blocked tool calls are reported at EVERY
# level. This setting controls noise, not safety reporting.
# VERBOSE_LEVEL=1

# ==============================================================================
# OPTIONAL - Claude Authentication
# ==============================================================================

# API key for environments without Claude Code CLI auth
# Get from: https://console.anthropic.com/
# Note: API usage is billed per token - CLI auth is more cost-effective
# ANTHROPIC_API_KEY=sk-ant-api03-...

# Default Claude model
# CLAUDE_MODEL=claude-sonnet-5

# Path to Claude CLI (auto-detected from PATH by default)
# CLAUDE_CLI_PATH=/usr/local/bin/claude

# Path to the Claude Code executable handed to the Agent SDK
# Only needed for standalone builds where the SDK cannot locate it itself
# CLAUDE_CODE_PATH=/usr/local/bin/claude

# ==============================================================================
# OPTIONAL - Documentation Lookup (alert handling)
# ==============================================================================

# Directory Claude scans for existing documentation before diagnosing an alert
# (past incidents, known issues, documented solutions)
# Default: ~/Documents/docs
# DOCS_DIR=/path/to/docs

# ==============================================================================
# OPTIONAL - Extended Thinking
# ==============================================================================

# Keywords that trigger adaptive thinking (comma-separated, case-insensitive)
# Values with spaces MUST be quoted (source .env parses them as shell commands)
# THINKING_KEYWORDS="think,denke,nachdenken"

# Keywords that trigger deep thinking (adaptive thinking, effort: max)
# THINKING_DEEP_KEYWORDS="ultrathink,denke genau,think hard"

# ==============================================================================
# OPTIONAL - Voice Transcription
# ==============================================================================

# Transcription mode: "local" (whisper-cli) or "off" (disabled)
# Default: "local" — uses whisper.cpp with local GGML model (no data leaves the machine)
# Requires: brew install whisper-cpp + GGML model in models/
# WHISPER_MODE=local

# Whisper language (ISO 639-1 code)
# Default: "de" (German)
# WHISPER_LANGUAGE=de

# Path to GGML whisper model
# Default: models/ggml-large-v3-turbo-q5_0.bin (relative to project root)
# WHISPER_MODEL_PATH=/path/to/ggml-model.bin

# Path to whisper-cli binary
# Default: auto-detected via PATH, fallback /opt/homebrew/bin/whisper-cli
# WHISPER_CLI_PATH=/opt/homebrew/bin/whisper-cli

# ==============================================================================
# OPTIONAL - Alert History Database
# ==============================================================================

# SQLite database for alert history (trend analysis, MTTR metrics, data-driven reports)
# Every incoming alert is persisted — does not affect queue or processing flow
# Default: ~/.cc-telegram-bot/alerts.db
# ALERT_DB_PATH=~/.cc-telegram-bot/alerts.db

# ==============================================================================
# OPTIONAL - Logging
# ==============================================================================

# Audit log path
# AUDIT_LOG_PATH=~/.cc-telegram-bot/audit.log

# Output audit logs as JSON (default: true, prevents log injection)
# AUDIT_LOG_JSON=true

# HMAC key for audit log integrity (auto-generated per session if not set)
# Set this for persistent verification across restarts
# AUDIT_LOG_HMAC_KEY=your-secret-hmac-key

# Max audit log size before rotation (default: 10MB)
# AUDIT_LOG_MAX_SIZE=10485760

# Number of rotated log files to keep (default: 5)
# AUDIT_LOG_MAX_FILES=5
